; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Servidor Maldito"
config/description="Servidor Maldito: juego educativo sobre virus informaticos (4 niveles + jefe final + trivia)"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameInput="*res://scripts/game_input.gd"
Sound="*res://scripts/sound.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=352
window/size/window_width_override=1280
window/size/window_height_override=704
window/stretch/mode="canvas_items"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="bullet"
2d_physics/layer_5="enemy_bullet"

[physics]

2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.071, 0.125, 1)
